# ------------------------------------------------------------------
# Loadbyton — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://loadbyton:loadbyton@localhost:5432/loadbyton?schema=public

# --- Redis (caching, rate limiting, session store) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- Supabase (optional — auth webhooks & storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (escrow payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=aed

# --- SMTP (transactional email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Observability ---
SENTRY_DSN=
LOGTAIL_TOKEN=

# --- Mapbox / tracking ---
MAPBOX_ACCESS_TOKEN=
